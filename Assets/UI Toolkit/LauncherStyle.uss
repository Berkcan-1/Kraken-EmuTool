/* Masaüstü Arka Planı (Koyu ve Bulanık Hissi) */
.desktop-bg {
    flex-grow: 1;
    background-color: rgb(32, 33, 36); /* Koyu gri, pencereyi öne çıkarır */
    align-items: center;
    justify-content: center;
}

/* Ana Program Penceresi (Windows / MacOS Profesyonel Uygulama Tarzı) */
.app-window {
    background-color: rgb(245, 245, 245);
    width: 680px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(150, 150, 150);
    border-bottom-width: 6px; /* Sahte 3D / SSAO derinlik hissi */
    border-bottom-color: rgb(20, 20, 20);
    overflow: hidden; /* Köşelerin taşmasını engeller */
}

/* Başlık Çubuğu */
.title-bar {
    background-color: rgb(45, 45, 48); /* Koyu profesyonel başlık */
    padding: 10px 15px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(20, 20, 20);
}

.title-text {
    font-size: 13px;
    color: rgb(230, 230, 230);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* İçerik Alanı (2 Sütunlu) */
.content-area {
    flex-direction: row;
    padding: 30px;
    background-color: rgb(250, 250, 250);
}

.panel-section {
    flex-grow: 1;
    width: 50%;
    padding: 0 15px;
}

.vertical-divider {
    width: 1px;
    background-color: rgb(210, 210, 210);
    margin: 0 15px;
}

/* Tipografi */
.section-header {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(30, 30, 30);
    margin-bottom: 5px;
}

.section-desc {
    font-size: 11px;
    color: rgb(100, 100, 100);
    margin-bottom: 20px;
    white-space: normal;
}

/* Detaylı Dropdown (Windows Stili) */
.detailed-dropdown {
    margin: 0 0 15px 0;
}

.detailed-dropdown .unity-base-field__input {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(180, 180, 180);
    border-radius: 4px;
    padding: 8px 10px;
    font-size: 13px;
    color: rgb(20, 20, 20);
    transition-duration: 0.15s;
}

.detailed-dropdown .unity-base-field__input:hover { border-color: rgb(0, 120, 215); }

/* Butonlar */
.btn-primary {
    background-color: rgb(0, 120, 215); /* Windows Mavi */
    color: white;
    font-size: 13px;
    -unity-font-style: bold;
    border-radius: 4px;
    padding: 12px;
    border-width: 1px;
    border-color: rgb(0, 90, 160);
    transition-duration: 0.15s;
}

.btn-primary:hover { background-color: rgb(0, 135, 240); }
.btn-primary:active { background-color: rgb(0, 90, 160); }

.btn-secondary {
    background-color: rgb(235, 235, 235);
    color: rgb(30, 30, 30);
    font-size: 13px;
    -unity-font-style: bold;
    border-radius: 4px;
    padding: 12px;
    border-width: 1px;
    border-color: rgb(180, 180, 180);
    transition-duration: 0.15s;
}

.btn-secondary:hover { background-color: rgb(225, 225, 225); }
.btn-secondary:active { background-color: rgb(200, 200, 200); }

/* Alt Durum Çubuğu (Büyük Çirkin Overlay Yerine) */
.status-bar {
    background-color: rgb(240, 240, 240);
    border-top-width: 1px;
    border-top-color: rgb(210, 210, 210);
    padding: 8px 15px;
    flex-direction: row;
    align-items: center;
}

.status-text {
    font-size: 11px;
    color: rgb(80, 80, 80);
    -unity-font-style: italic;
}

.status-spinner {
    width: 14px;
    height: 14px;
    border-width: 2px;
    border-radius: 7px;
    border-color: rgb(0, 120, 215);
    border-top-color: transparent;
    margin-right: 8px;
}

/* ======================================= */
/* SPLASH SCREEN (BEMBEYAZ & DİNAMİK)      */
/* ======================================= */
.splash-container {
    position: absolute;
    top: 0; bottom: 0; left: 0; right: 0;
    background-color: rgb(255, 255, 255); /* Dinamik Beyaz Ekran */
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.8s; /* Pürüzsüz yavaş kaybolma */
}

.splash-logo {
    width: 200px;
    height: 200px;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 50px;
}

.splash-spinner {
    width: 30px;
    height: 30px;
    border-width: 3px;
    border-radius: 15px;
    border-color: rgb(150, 150, 150);
    border-top-color: rgb(0, 120, 215);
    transition-property: opacity;
    transition-duration: 1s; /* Yavaşça belirme animasyonu */
}

/* ======================================= */
/* SOCIAL BUTTONS (SAĞ ALT KÖŞE)           */
/* ======================================= */
.social-container {
    position: absolute;
    bottom: 20px;
    right: 20px;
    flex-direction: row;
}

.social-btn {
    background-color: rgb(45, 45, 48);
    color: rgb(230, 230, 230);
    font-size: 12px;
    -unity-font-style: bold;
    border-radius: 12px;
    padding: 6px 16px;
    margin-left: 10px;
    border-width: 1px;
    border-color: rgb(20, 20, 20);
    cursor: link;
    transition-duration: 0.15s;
}

.social-btn:hover {
    background-color: rgb(0, 120, 215);
    color: white;
    border-color: rgb(0, 90, 160);
    scale: 1.05;
}