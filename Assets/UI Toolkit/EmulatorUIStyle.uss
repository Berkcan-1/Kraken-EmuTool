/* Ana Taşıyıcı: Sol Üste Sabitliyoruz */
.ui-root {
    position: absolute;
    top: 20px;
    left: 20px;
    flex-direction: row;
}

/* Sol Menü (Sidebar - Butonlar) */
.sidebar {
    width: 65px;
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 16px;
    padding: 10px;
    align-items: center;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
}

/* Çıkış Butonu */
.exit-btn {
    background-color: #ff3b30;
    color: white;
    margin-top: 30px; /* Diğer sekmelerle arasına boşluk koyar */
}
.exit-btn:hover {
    background-color: #d70015;
}

.tab-btn {
    width: 45px;
    height: 45px;
    border-radius: 12px;
    margin-bottom: 10px;
    background-color: rgb(242, 242, 247);
    border-width: 0;
    -unity-font-style: bold;
    font-size: 20px;
    color: rgb(134, 134, 139);
    transition-duration: 0.15s;
}

.tab-btn:hover { background-color: rgb(229, 229, 234); }
.tab-btn.active { background-color: rgb(0, 113, 227); color: white; }

/* İçerik Paneli (Sağdaki Açılır Menü) */
.panel-container {
    margin-left: 15px;
    width: 320px;
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 16px;
    padding: 20px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.05);
    display: none; /* Kod ile sadece seçili olan Flex yapılacak */
}

.panel-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(29, 29, 31);
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.panel-subtitle {
    font-size: 11px;
    color: rgb(134, 134, 139);
    margin-top: 10px;
    margin-bottom: 5px;
}

/* Aksiyon Butonları */
.action-btn {
    background-color: rgb(242, 242, 247);
    color: rgb(29, 29, 31);
    font-size: 13px;
    -unity-font-style: bold;
    border-radius: 10px;
    padding: 10px;
    margin-bottom: 5px;
    border-width: 0;
    transition-duration: 0.1s;
}

.action-btn:hover { background-color: rgb(229, 229, 234); }
.action-btn:active { background-color: rgb(0, 113, 227); color: white; }

/* Terminal Input */
.adb-input { margin-bottom: 10px; }
.adb-input .unity-base-field__input {
    background-color: rgb(242, 242, 247);
    border-width: 0;
    border-radius: 8px;
    padding: 10px;
    color: rgb(29, 29, 31);
}

.log-label {
    font-size: 11px;
    color: rgb(134, 134, 139);
    margin-top: 10px;
    white-space: normal; /* Uzun çıktıları alt satıra atar */
}


.app-list-scroll {
    flex-grow: 1;
    /* DİKKAT: Sabit height'ı sildik! Artık içi boşsa küçülür, doluysa büyür. 
       Ekrandan taşmasın diye max-height verdik. */
    max-height: 400px; 
    min-height: 40px;
    margin-top: 10px;
    background-color: rgba(0, 0, 0, 0.02);
    border-radius: 12px;
    padding: 8px;
}

.app-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgb(242, 242, 247);
    border-radius: 8px;
    padding: 6px 10px;
    margin-bottom: 6px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.03);
}

/* YENİ: Dinamik İkon Kutusu */
.app-icon-box {
    width: 26px;
    height: 26px;
    border-radius: 6px; /* Hafif yuvarlak köşeli Apple stili kare */
    align-items: center;
    justify-content: center;
    margin-right: 10px;
}

.app-icon-letter {
    font-size: 14px;
    -unity-font-style: bold;
    color: white;
}

.app-name {
    font-size: 11px;
    color: rgb(29, 29, 31);
    -unity-font-style: bold;
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.app-del-btn {
    background-color: #ff3b30;
    color: white;
    font-size: 10px;
    -unity-font-style: bold;
    border-radius: 6px;
    padding: 6px 12px;
    border-width: 0;
    cursor: link;
    transition-duration: 0.15s;
}

.app-text-container {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    margin-right: 8px;
}

.app-package-name {
    font-size: 9px;
    color: rgb(134, 134, 139);
    overflow: hidden;
    text-overflow: ellipsis;
}

/* --- SÖKÜLEN PARÇALAR (ENVANTER) --- */
.part-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgb(242, 242, 247);
    border-radius: 8px;
    padding: 10px 12px;
    margin-bottom: 6px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.03);
}

.part-name {
    font-size: 13px;
    color: rgb(29, 29, 31);
    -unity-font-style: bold;
    flex-grow: 1;
}

.part-restore-btn {
    background-color: rgb(52, 199, 89); /* Apple Yeşili */
    color: white;
    font-size: 11px;
    -unity-font-style: bold;
    border-radius: 6px;
    padding: 8px 14px;
    border-width: 0;
    cursor: link;
    transition-duration: 0.15s;
}

/* --- SAĞDAN KAYAN EDL PANELİ --- */
.edl-slide-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    right: -450px; /* Normalde ekran dışında gizli */
    width: 380px;
    background-color: rgba(255, 255, 255, 0.95);
    border-left-width: 1px;
    border-color: rgba(0, 0, 0, 0.1);
    padding: 30px;
    transition-property: right;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out;
}

/* C# içinden panele bu class eklendiğinde sağdan fırlayacak */
.edl-slide-panel.open {
    right: 0; 
}

/* --- SAĞDAN KAYAN FASTBOOT PANELİ --- */
.fastboot-slide-panel {
    position: absolute; top: 0; bottom: 0; right: -450px; width: 380px;
    background-color: rgba(255, 255, 255, 0.95);
    border-left-width: 1px; border-color: rgba(0, 0, 0, 0.1);
    padding: 30px; transition-property: right; transition-duration: 0.4s; transition-timing-function: ease-in-out;
}
.fastboot-slide-panel.open { right: 0; }

.part-restore-btn:hover { background-color: rgb(48, 209, 88); scale: 1.05; }
.part-restore-btn:active { background-color: rgb(36, 138, 61); scale: 0.95; }

.app-del-btn:hover { background-color: #ff453a; scale: 1.05; }
.app-del-btn:active { background-color: #d70015; scale: 0.95; }

/* ======================================= */
/* SETUP OVERLAY (KURULUM REHBERİ)         */
/* ======================================= */
.setup-overlay {
    position: absolute;
    top: 0; bottom: 0; left: 0; right: 0;
    align-items: center;
    justify-content: center;
}

.setup-card {
    background-color: rgb(245, 245, 245);
    width: 500px;
    border-radius: 8px;
    padding: 40px;
    border-width: 1px;
    border-color: rgb(150, 150, 150);
    border-bottom-width: 6px;
    border-bottom-color: rgb(20, 20, 20);
}

.setup-steps {
    background-color: rgb(235, 235, 235);
    padding: 15px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(200, 200, 200);
}

.step-text {
    font-size: 13px;
    color: rgb(50, 50, 50);
    margin-bottom: 6px;
    -unity-font-style: bold;
}