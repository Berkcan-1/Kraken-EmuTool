<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="LauncherStyle.uss" />
    
    
    <ui:VisualElement class="desktop-bg">
        
        
        <ui:VisualElement name="appWindow" class="app-window">
            
            
            <ui:VisualElement class="title-bar">
                <ui:Label text="Kraken Launcher" class="title-text" />
            </ui:VisualElement>

            
            <ui:VisualElement class="content-area">
                
                
                <ui:VisualElement class="panel-section">
                    <ui:Label text="Installed Devices" class="section-header" />
                    <ui:Label text="Select an existing virtual machine to boot into the 3D environment." class="section-desc" />
                    <ui:DropdownField name="existingAvdDropdown" choices="Searching for devices..." index="0" class="detailed-dropdown" />
                    <ui:Button text="Launch Selected Device" name="launchBtn" class="btn-primary" />
                </ui:VisualElement>

                
                <ui:VisualElement class="vertical-divider" />

                
                <ui:VisualElement class="panel-section">
                    <ui:Label text="Create New Environment" class="section-header" />
                    <ui:Label text="Download and deploy a new Android AOSP system image automatically." class="section-desc" />
                    <ui:DropdownField name="newVersionDropdown" choices="Loading versions..." index="0" class="detailed-dropdown" />
                    <ui:Button text="Download &amp; Create" name="createBtn" class="btn-secondary" />
                </ui:VisualElement>

            </ui:VisualElement>

            
            <ui:VisualElement class="status-bar">
                <ui:VisualElement name="statusSpinner" class="status-spinner" style="display: none;" />
                <ui:Label name="loadingDetails" text="System Ready. Waiting for user input..." class="status-text" />
            </ui:VisualElement>

        </ui:VisualElement>

        
        <ui:VisualElement name="setupOverlay" class="setup-overlay" style="display: none;">
            <ui:VisualElement class="setup-card">
                <ui:Label text="⚠️ Setup Required" class="header" style="color: #ff3b30;" />
                <ui:Label text="We couldn't detect the required Android SDK components on your system." class="subheader" style="margin-bottom: 20px;" />

                <ui:VisualElement class="setup-steps">
                    <ui:Label text="Step 1: Install Android Studio." class="step-text" />
                    <ui:Label text="Step 2: Open Android Studio &gt; SDK Manager." class="step-text" />
                    <ui:Label text="Step 3: Go to the 'SDK Tools' tab." class="step-text" />
                    <ui:Label text="Step 4: Check 'Android SDK Command-line Tools (latest)'." class="step-text" />
                    <ui:Label text="Step 5: Check 'Android Emulator'." class="step-text" />
                    <ui:Label text="Step 6: Click Apply and wait for the installation to finish." class="step-text" />
                </ui:VisualElement>

                <ui:Button name="btnCheckAgain" text="I've Installed Them - Check Again" class="btn-primary" style="margin-top: 25px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        
        <ui:VisualElement class="social-container">
            <ui:Button name="btnGithub" text="GitHub" class="social-btn" />
            <ui:Button name="btnLinkedin" text="LinkedIn" class="social-btn" />
        </ui:VisualElement>

    </ui:VisualElement>

    
    <ui:VisualElement name="splashContainer" class="splash-container">
        
        <ui:VisualElement name="splashLogo" class="splash-logo" />
        <ui:VisualElement name="splashSpinner" class="splash-spinner" />
    </ui:VisualElement>

</ui:UXML>